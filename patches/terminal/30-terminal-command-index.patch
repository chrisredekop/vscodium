+import { localize2 } from '../../../../../nls.js';
+import { Action2, registerAction2 } from '../../../../../platform/actions/common/actions.js';
+import { ServicesAccessor } from '../../../../../platform/instantiation/common/instantiation.js';
+import { TerminalCapability } from '../../../../../platform/terminal/common/capabilities/capabilities.js';
+import { ITerminalInstance, ITerminalService } from '../../../terminal/browser/terminal.js';
+
+/**
+ * Exposes the shell-integration command history of a terminal to extensions, keyed by the
+ * terminal's process id (available to extensions as `Terminal.processId`).
+ */
+
+interface ICommandIndexEntry {
+	index: number;
+	commandLine: string;
+	timestamp: number;
+	duration: number;
+	exitCode: number | undefined;
+	cwd: string | undefined;
+}
+
+function findInstance(terminalService: ITerminalService, args: { processId?: number } | undefined): ITerminalInstance | undefined {
+	if (typeof args?.processId !== 'number') {
+		return undefined;
+	}
+	return terminalService.instances.find(instance => instance.processId === args.processId);
+}
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: 'workbench.action.terminal.getCommandIndex',
+			title: localize2('workbench.action.terminal.getCommandIndex', 'Get Terminal Command Index'),
+			f1: false
+		});
+	}
+	run(accessor: ServicesAccessor, args?: { processId: number }): ICommandIndexEntry[] {
+		const instance = findInstance(accessor.get(ITerminalService), args);
+		const commands = instance?.capabilities.get(TerminalCapability.CommandDetection)?.commands ?? [];
+		return commands.map((command, index) => ({
+			index,
+			commandLine: command.command,
+			timestamp: command.timestamp,
+			duration: command.duration,
+			exitCode: command.exitCode,
+			cwd: command.cwd
+		}));
+	}
+});
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: 'workbench.action.terminal.revealCommandIndex',
+			title: localize2('workbench.action.terminal.revealCommandIndex', 'Reveal Terminal Command by Index'),
+			f1: false
+		});
+	}
+	async run(accessor: ServicesAccessor, args?: { processId: number; index: number }): Promise<void> {
+		const terminalService = accessor.get(ITerminalService);
+		const instance = findInstance(terminalService, args);
+		const command = instance?.capabilities.get(TerminalCapability.CommandDetection)?.commands[args?.index ?? -1];
+		if (!instance || !command) {
+			return;
+		}
+		terminalService.setActiveInstance(instance);
+		await terminalService.revealActiveTerminal(true);
+		const xterm = await instance.xtermReadyPromise;
+		xterm?.markTracker.revealCommand(command);
+	}
+});
