{
	"name": "terminal-first",
	"displayName": "Terminal First",
	"description": "Terminal-first defaults: terminals as editor tabs, Windows-Terminal-style keybindings and colors, minimal chrome.",
	"version": "1.0.0",
	"publisher": "vscodium",
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"contributes": {
		"configurationDefaults": {
			"workbench.startupEditor": "terminal",
			"terminal.integrated.defaultLocation": "editor",
			"workbench.activityBar.location": "hidden",
			"window.menuBarVisibility": "hidden",
			"window.commandCenter": false,
			"workbench.layoutControl.enabled": false,
			"workbench.editor.empty.hint": "hidden",
			"workbench.tips.enabled": false,
			"workbench.editor.showTabs": "multiple",
			"window.closeWhenEmpty": true,
			"terminal.integrated.gpuAcceleration": "on",
			"terminal.integrated.shellIntegration.enabled": true,
			"terminal.integrated.suggest.enabled": true,
			"terminal.integrated.stickyScroll.enabled": true,
			"terminal.integrated.enableImages": true,
			"terminal.integrated.defaultProfile.windows": "PowerShell",
			"terminal.integrated.profiles.windows": {
				"PowerShell": { "source": "PowerShell", "icon": "terminal-powershell", "color": "terminal.ansiBlue" },
				"Windows PowerShell": { "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "icon": "terminal-powershell", "color": "terminal.ansiCyan" },
				"Command Prompt": { "path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"], "args": [], "icon": "terminal-cmd", "color": "terminal.ansiYellow" },
				"Git Bash": { "source": "Git Bash", "icon": "terminal-bash", "color": "terminal.ansiGreen" }
			},
			"terminal.integrated.fontFamily": "'Cascadia Mono', 'Cascadia Code', Consolas, 'Courier New', monospace",
			"terminal.integrated.cursorStyle": "line",
			"terminal.integrated.cursorBlinking": true,
			"terminal.integrated.enableMultiLinePasteWarning": "never",
			"terminal.integrated.confirmOnKill": "never",
			"terminal.integrated.commandsToSkipShell": [
				"workbench.action.closeActiveEditor",
				"workbench.action.nextEditor",
				"workbench.action.previousEditor",
				"workbench.action.openEditorAtIndex1",
				"workbench.action.openEditorAtIndex2",
				"workbench.action.openEditorAtIndex3",
				"workbench.action.openEditorAtIndex4",
				"workbench.action.openEditorAtIndex5",
				"workbench.action.openEditorAtIndex6",
				"workbench.action.openEditorAtIndex7",
				"workbench.action.openEditorAtIndex8",
				"workbench.action.openEditorAtIndex9",
				"workbench.action.splitEditorDown",
				"workbench.action.splitEditorRight",
				"workbench.action.focusAboveGroup",
				"workbench.action.focusBelowGroup",
				"workbench.action.focusLeftGroup",
				"workbench.action.focusRightGroup"
			],
			"workbench.colorCustomizations": {
				"[Dark Modern]": {
					"terminal.background": "#0C0C0C",
					"terminal.foreground": "#CCCCCC",
					"terminalCursor.foreground": "#FFFFFF",
					"terminal.selectionBackground": "#FFFFFF40",
					"terminal.ansiBlack": "#0C0C0C",
					"terminal.ansiRed": "#C50F1F",
					"terminal.ansiGreen": "#13A10E",
					"terminal.ansiYellow": "#C19C00",
					"terminal.ansiBlue": "#0037DA",
					"terminal.ansiMagenta": "#881798",
					"terminal.ansiCyan": "#3A96DD",
					"terminal.ansiWhite": "#CCCCCC",
					"terminal.ansiBrightBlack": "#767676",
					"terminal.ansiBrightRed": "#E74856",
					"terminal.ansiBrightGreen": "#16C60C",
					"terminal.ansiBrightYellow": "#F9F1A5",
					"terminal.ansiBrightBlue": "#3B78FF",
					"terminal.ansiBrightMagenta": "#B4009E",
					"terminal.ansiBrightCyan": "#61D6D6",
					"terminal.ansiBrightWhite": "#F2F2F2",
					"editor.background": "#0C0C0C",
					"editorGroupHeader.tabsBackground": "#0C0C0C",
					"tab.activeBackground": "#1F1F1F",
					"tab.inactiveBackground": "#0C0C0C",
					"titleBar.activeBackground": "#0C0C0C",
					"titleBar.inactiveBackground": "#0C0C0C",
					"statusBar.background": "#0C0C0C",
					"statusBar.border": "#2B2B2B"
				}
			}
		},
		"keybindings": [
			{ "command": "workbench.action.terminal.new", "key": "ctrl+shift+t" },
			{ "command": "workbench.action.terminal.newWithProfile", "key": "ctrl+shift+space" },
			{ "command": "workbench.action.closeActiveEditor", "key": "ctrl+shift+w" },
			{ "command": "workbench.action.nextEditor", "key": "ctrl+tab" },
			{ "command": "workbench.action.previousEditor", "key": "ctrl+shift+tab" },
			{ "command": "workbench.action.openEditorAtIndex1", "key": "ctrl+alt+1" },
			{ "command": "workbench.action.openEditorAtIndex2", "key": "ctrl+alt+2" },
			{ "command": "workbench.action.openEditorAtIndex3", "key": "ctrl+alt+3" },
			{ "command": "workbench.action.openEditorAtIndex4", "key": "ctrl+alt+4" },
			{ "command": "workbench.action.openEditorAtIndex5", "key": "ctrl+alt+5" },
			{ "command": "workbench.action.openEditorAtIndex6", "key": "ctrl+alt+6" },
			{ "command": "workbench.action.openEditorAtIndex7", "key": "ctrl+alt+7" },
			{ "command": "workbench.action.openEditorAtIndex8", "key": "ctrl+alt+8" },
			{ "command": "workbench.action.openEditorAtIndex9", "key": "ctrl+alt+9" },
			{ "command": "workbench.action.terminal.split", "key": "alt+shift+d", "when": "terminalFocus" },
			{ "command": "workbench.action.splitEditorDown", "key": "alt+shift+-" },
			{ "command": "workbench.action.splitEditorRight", "key": "alt+shift+=" },
			{ "command": "workbench.action.focusAboveGroup", "key": "alt+up" },
			{ "command": "workbench.action.focusBelowGroup", "key": "alt+down" },
			{ "command": "workbench.action.terminal.focusFind", "key": "ctrl+shift+f", "when": "terminalFocus" },
			{ "command": "workbench.action.terminal.selectAll", "key": "ctrl+shift+a", "when": "terminalFocus" },
			{ "command": "workbench.action.terminal.rename", "key": "f2", "when": "terminalFocus" },
			{ "command": "workbench.action.terminal.fontZoomIn", "key": "ctrl+=", "when": "terminalFocus" },
			{ "command": "workbench.action.terminal.fontZoomOut", "key": "ctrl+-", "when": "terminalFocus" },
			{ "command": "workbench.action.terminal.fontZoomReset", "key": "ctrl+0", "when": "terminalFocus" }
		],
		"menus": {
			"editor/title": [
				{ "command": "workbench.action.terminal.newWithProfile", "group": "1_terminal@1", "when": "terminalEditorActive" },
				{ "command": "workbench.action.terminal.split", "group": "1_terminal@2", "when": "terminalEditorActive" },
				{ "command": "workbench.action.terminal.rename", "group": "2_terminal@1", "when": "terminalEditorActive" },
				{ "command": "workbench.action.terminal.changeColor", "group": "2_terminal@2", "when": "terminalEditorActive" },
				{ "command": "workbench.action.terminal.changeIcon", "group": "2_terminal@3", "when": "terminalEditorActive" },
				{ "command": "workbench.action.terminal.selectDefaultShell", "group": "3_terminal@1", "when": "terminalEditorActive" }
			]
		}
	}
}
